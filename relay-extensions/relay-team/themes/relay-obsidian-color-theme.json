{
  "$schema": "vscode://schemas/color-theme",
  "name": "Relay Obsidian",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "focusBorder": "#7C6CF222",
    "foreground": "#D8DCE7",
    "descriptionForeground": "#8C93A5",
    "errorForeground": "#FF6B7A",
    "icon.foreground": "#949BAD",
    "selection.background": "#6254D755",
    "activityBar.background": "#090A0E",
    "activityBar.foreground": "#F2F0FF",
    "activityBar.inactiveForeground": "#676D7C",
    "activityBar.border": "#00000000",
    "activityBarBadge.background": "#7867F2",
    "activityBarBadge.foreground": "#FFFFFF",
    "sideBar.background": "#0C0E13",
    "sideBar.foreground": "#C8CDD8",
    "sideBar.border": "#171A22",
    "sideBarSectionHeader.background": "#0C0E13",
    "sideBarSectionHeader.foreground": "#8C93A5",
    "sideBarTitle.foreground": "#E8EAF1",
    "editor.background": "#0A0C10",
    "editor.foreground": "#D5D9E3",
    "editorLineNumber.foreground": "#3E4350",
    "editorLineNumber.activeForeground": "#9097A8",
    "editorCursor.foreground": "#A89BFF",
    "editor.selectionBackground": "#5C4FD84A",
    "editor.inactiveSelectionBackground": "#5C4FD825",
    "editor.lineHighlightBackground": "#FFFFFF05",
    "editorIndentGuide.background1": "#FFFFFF0A",
    "editorIndentGuide.activeBackground1": "#7867F255",
    "editorWidget.background": "#11141B",
    "editorWidget.border": "#262B37",
    "editorGroupHeader.tabsBackground": "#090B0F",
    "editorGroup.border": "#151821",
    "tab.activeBackground": "#0E1117",
    "tab.inactiveBackground": "#090B0F",
    "tab.activeForeground": "#F0F1F6",
    "tab.inactiveForeground": "#747B8C",
    "tab.activeBorderTop": "#7867F2",
    "tab.border": "#00000000",
    "panel.background": "#090B10",
    "panel.border": "#181B24",
    "panelTitle.activeForeground": "#ECEEF4",
    "panelTitle.activeBorder": "#7867F2",
    "terminal.background": "#090B10",
    "terminal.foreground": "#C7CCD8",
    "statusBar.background": "#090A0E",
    "statusBar.foreground": "#8F96A7",
    "statusBar.border": "#171A22",
    "titleBar.activeBackground": "#08090D",
    "titleBar.activeForeground": "#DDE0E8",
    "titleBar.border": "#171A22",
    "input.background": "#11141B",
    "input.border": "#242936",
    "input.foreground": "#E3E5EB",
    "button.background": "#6E5DE7",
    "button.hoverBackground": "#7D6CF2",
    "badge.background": "#29243F",
    "badge.foreground": "#CFC8FF",
    "scrollbarSlider.background": "#FFFFFF12",
    "scrollbarSlider.hoverBackground": "#FFFFFF20"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#596172", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#A99BFF" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#9DCEA7" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#E7B879" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#78BFEA" } },
    { "scope": ["entity.name.type", "support.type", "support.class"], "settings": { "foreground": "#E4C184" } },
    { "scope": ["variable", "meta.definition.variable.name"], "settings": { "foreground": "#D5D9E3" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#D7A1C8" } }
  ]
}
